#!/usr/bin/env python3
"""
bbpr — fetch Bitbucket Cloud PR for review (info, diff, comments, files).

Usage:
  bbpr <pr-url-or-number> [info|diff|comments|files|activity|all]
  bbpr <pr-url-or-number>                       # = all
  bbpr 605                                       # uses current git remote
  bbpr https://bitbucket.org/ws/repo/pull-requests/605
  bbpr 605 diff -n                               # diff with resolved line numbers
  bbpr setup                                     # configure credentials

  # write actions (need write:pullrequest:bitbucket scope):
  bbpr <t> comment -m "text"                     # general PR comment
  bbpr <t> comment --path F --line N -m "text"   # inline on new-file line N
  bbpr <t> comment --path F --old-line N -m "."  # inline on a deleted line
  bbpr <t> comment --reply-to <id> -m "text"     # reply in a thread
  bbpr <t> comment --path F --line N             # body read from stdin
  bbpr <t> comment "text" [path] [new-line]      # legacy positional form
  bbpr <t> approve
  bbpr <t> request-changes
  bbpr <t> unapprove

Auth:
  Reads BITBUCKET_EMAIL + BITBUCKET_API_TOKEN from env, or from
  ~/.config/bbpr/credentials (KEY=value, chmod 600 recommended).
  Use an Atlassian API token — click "Create API token with scopes" at
  https://id.atlassian.com/manage-profile/security/api-tokens
  Required scopes: read:user:bitbucket, read:pullrequest:bitbucket
  For write actions also add: write:pullrequest:bitbucket
"""
import argparse
import getpass
import os
import re
import sys
import time
import subprocess
import urllib.request
from pathlib import Path

import requests

API = "https://api.bitbucket.org/2.0"
REMOTE = "https://raw.githubusercontent.com/tejasnafde/bbpr/main"
RAW_URL = f"{REMOTE}/bbpr"
STAMP = Path.home() / ".cache" / "bbpr-update-check"
SKILL_PATHS = Path.home() / ".config" / "bbpr" / "skill-paths"


def update_skills():
    """Refresh skill files install.sh recorded. Best-effort, never blocks."""
    if not SKILL_PATHS.exists():
        return
    cache = {}
    for line in SKILL_PATHS.read_text().splitlines():
        dest = Path(line.strip()).expanduser()
        if not line.strip() or not dest.exists():
            continue
        name = "skill.mdc" if dest.suffix == ".mdc" else "skill.md"
        try:
            if name not in cache:
                cache[name] = urllib.request.urlopen(
                    f"{REMOTE}/{name}", timeout=3
                ).read()
            if cache[name] and cache[name] != dest.read_bytes():
                dest.write_bytes(cache[name])
        except Exception:
            pass


def maybe_self_update():
    """Best-effort: replace the installed script with the latest, once a day."""
    real = os.path.realpath(__file__)
    if not real.startswith(os.path.expanduser("~/.local/bin")):
        return  # ponytail: never self-mutate the dev/repo copy
    try:
        if STAMP.exists() and time.time() - STAMP.stat().st_mtime < 86400:
            return
        latest = urllib.request.urlopen(RAW_URL, timeout=3).read()
        STAMP.parent.mkdir(parents=True, exist_ok=True)
        STAMP.touch()  # stamp regardless, so a flaky net doesn't retry every run
        update_skills()
        if latest and latest != Path(real).read_bytes():
            Path(real).write_bytes(latest)
            print("bbpr updated — re-run your command.", file=sys.stderr)
            sys.exit(0)
    except Exception:
        pass  # update is best-effort, never block the actual command


# ── Auth ──────────────────────────────────────────────────────────────────────

def load_creds():
    email = os.environ.get("BITBUCKET_EMAIL")
    token = os.environ.get("BITBUCKET_API_TOKEN")
    cfg = Path.home() / ".config" / "bbpr" / "credentials"
    if cfg.exists():
        data = {}
        for line in cfg.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            data[k.strip()] = v.strip().strip('"').strip("'")
        email = email or data.get("BITBUCKET_EMAIL")
        token = token or data.get("BITBUCKET_API_TOKEN")
    if not email or not token:
        sys.exit(
            "error: credentials not found.\n"
            "Run 'bbpr setup' to configure, or set BITBUCKET_EMAIL and\n"
            "BITBUCKET_API_TOKEN as env vars or in ~/.config/bbpr/credentials"
        )
    return email, token


def cmd_setup():
    """Interactive credentials setup wizard."""
    print("bbpr setup — Bitbucket credentials wizard")
    print("==========================================")
    print()
    print("You'll need an Atlassian API token.")
    print("→ https://id.atlassian.com/manage-profile/security/api-tokens")
    print()
    print("IMPORTANT: click 'Create API token with scopes' (not the plain one).")
    print()
    print("Required scopes:")
    print("  • read:user:bitbucket")
    print("  • read:pullrequest:bitbucket")
    print("  • write:pullrequest:bitbucket   (for comment/approve/request-changes)")
    print()

    email = input("Atlassian email: ").strip()
    if not email:
        sys.exit("error: email cannot be empty")

    token = getpass.getpass("API token (input hidden): ").strip()
    if not token:
        sys.exit("error: token cannot be empty")

    print()
    print("Verifying credentials...", end=" ", flush=True)
    try:
        r = requests.get(f"{API}/user", auth=(email, token), timeout=10)
        if r.ok:
            display_name = r.json().get("display_name", "unknown")
            print(f"✓  (authenticated as {display_name})")
        else:
            print("✗")
            sys.exit(
                f"error: credentials rejected (HTTP {r.status_code}) — "
                "check your email and token"
            )
    except requests.exceptions.RequestException as e:
        print("✗")
        sys.exit(f"error: network error — {e}")

    cfg_dir = Path.home() / ".config" / "bbpr"
    cfg_dir.mkdir(parents=True, exist_ok=True)
    cfg_file = cfg_dir / "credentials"
    cfg_file.write_text(f"BITBUCKET_EMAIL={email}\nBITBUCKET_API_TOKEN={token}\n")
    cfg_file.chmod(0o600)

    print(f"✓  Credentials saved to {cfg_file}")
    print()
    print("Run 'bbpr <pr-url-or-number>' to review a PR.")


# ── Parsing ───────────────────────────────────────────────────────────────────

def parse_target(arg):
    m = re.match(
        r"https?://bitbucket\.org/([^/]+)/([^/]+)/pull-requests/(\d+)", arg
    )
    if m:
        return m.group(1), m.group(2), int(m.group(3))
    if arg.isdigit():
        try:
            url = subprocess.check_output(
                ["git", "config", "--get", "remote.origin.url"],
                text=True,
                stderr=subprocess.DEVNULL,
            ).strip()
        except subprocess.CalledProcessError:
            sys.exit("error: not in a git repo — pass the full PR URL instead")
        m = re.search(r"bitbucket\.org[:/]([^/]+)/([^/.]+)", url)
        if not m:
            sys.exit(f"error: can't parse workspace/repo from remote {url!r}")
        return m.group(1), m.group(2), int(arg)
    sys.exit(f"error: can't parse target {arg!r}")


# ── HTTP helpers ──────────────────────────────────────────────────────────────

def get(session, url, **kwargs):
    r = session.get(url, **kwargs)
    if not r.ok:
        sys.exit(f"error: HTTP {r.status_code} on {url}\n{r.text[:500]}")
    return r


def post(session, url, json=None):
    r = session.post(url, json=json)
    if not r.ok:
        sys.exit(f"error: HTTP {r.status_code} on {url}\n{r.text[:500]}")
    return r


def paginate(session, url):
    while url:
        data = get(session, url).json()
        yield from data.get("values", [])
        url = data.get("next")


# ── Formatters ────────────────────────────────────────────────────────────────

def fmt_info(pr):
    print(f"# PR #{pr['id']}: {pr['title']}")
    print(f"State:  {pr['state']}")
    print(f"Author: {pr['author']['display_name']}")
    print(f"Source: {pr['source']['branch']['name']}")
    print(f"Target: {pr['destination']['branch']['name']}")
    print(f"URL:    {pr['links']['html']['href']}")
    reviewers = pr.get("reviewers") or []
    if reviewers:
        print("Reviewers: " + ", ".join(r["display_name"] for r in reviewers))
    participants = [p for p in (pr.get("participants") or []) if p.get("approved")]
    if participants:
        print("Approvals: " + ", ".join(p["user"]["display_name"] for p in participants))
    print()
    print("## Description")
    print(pr.get("description") or "(empty)")
    print()


def fmt_files(session, base):
    print("## Files changed")
    for d in paginate(session, f"{base}/diffstat?pagelen=100"):
        status = d.get("status", "?")
        path = (d.get("new") or d.get("old") or {}).get("path", "?")
        lines = f"+{d.get('lines_added', 0)} -{d.get('lines_removed', 0)}"
        print(f"  {status:10s} {lines:14s} {path}")
    print()


def fmt_comments(session, base):
    print("## Comments")
    any_c = False
    for c in paginate(session, f"{base}/comments?pagelen=100"):
        if c.get("deleted"):
            continue
        any_c = True
        author = c["user"]["display_name"]
        text = (c.get("content") or {}).get("raw", "")
        inline = c.get("inline")
        loc = ""
        if inline:
            path = inline.get("path", "?")
            line = inline.get("to") or inline.get("from")
            side = "new" if inline.get("to") else "old"
            loc = f" — {path}:{line} ({side})" if line else f" — {path}"
        parent = c.get("parent")
        prefix = "  ↳ reply" if parent else "---"
        print(f"{prefix} {author}{loc}")
        print(text)
        print()
    if not any_c:
        print("(no comments)\n")


def fmt_activity(session, base):
    print("## Activity")
    for a in paginate(session, f"{base}/activity?pagelen=50"):
        for kind in ("approval", "changes_requested", "update", "comment"):
            if kind in a:
                entry = a[kind]
                user = (
                    entry.get("user", {}).get("display_name")
                    if isinstance(entry, dict) else None
                ) or "?"
                date = (
                    entry.get("date") if isinstance(entry, dict) else None
                ) or a.get("date", "")
                print(f"  [{date}] {kind:18s} by {user}")
                break
    print()


HUNK = re.compile(r"@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@")


def number_diff(text):
    """Annotate each diff line with its resolved old/new file line number.

    Gutter is "<num> <sign> | ", so the code is still greppable after "| ".
    """
    old = new = 0
    out = []
    for ln in text.splitlines():
        m = HUNK.match(ln) if ln.startswith("@@") else None
        if m:
            old, new = int(m.group(1)), int(m.group(2))
        if m or not ln.startswith((" ", "+", "-")) or ln.startswith(("+++", "---")):
            out.append(f"{'':>5}   | {ln}")
        elif ln.startswith("+"):
            out.append(f"{new:>5} + | {ln[1:]}")
            new += 1
        elif ln.startswith("-"):
            out.append(f"{old:>5} - | {ln[1:]}")
            old += 1
        else:
            out.append(f"{new:>5}   | {ln[1:]}")
            old += 1
            new += 1
    return "\n".join(out)


def fmt_diff(session, pr, numbered=False):
    print("## Diff")
    r = get(session, pr["links"]["diff"]["href"])
    print(number_diff(r.text) if numbered else r.text)


# ── Write actions ─────────────────────────────────────────────────────────────

def do_comment(session, base, argv):
    p = argparse.ArgumentParser(prog="bbpr <pr> comment")
    p.add_argument("pos", nargs="*", help="legacy: text [path] [new-line]")
    p.add_argument("-m", "--message", help="comment body (default: stdin)")
    p.add_argument("--path", help="file path for an inline comment")
    p.add_argument("--line", type=int, help="new-file line number")
    p.add_argument("--old-line", type=int, help="old-file line (deleted line)")
    p.add_argument("--reply-to", type=int, help="parent comment id")
    a = p.parse_args(argv[3:])

    text = a.message or (a.pos[0] if a.pos else "")
    if not text and not sys.stdin.isatty():
        text = sys.stdin.read().strip()
    if not text:
        sys.exit('error: comment body required — pass -m "text" or pipe it on stdin')

    path = a.path or (a.pos[1] if len(a.pos) > 1 else None)
    line = a.line if a.line is not None else (
        int(a.pos[2]) if len(a.pos) > 2 else None
    )
    if path and line is None and a.old_line is None:
        sys.exit("error: --path needs --line (or --old-line)")
    if not path and (line is not None or a.old_line is not None):
        sys.exit("error: --line needs --path")

    body = {"content": {"raw": text}}
    if path:
        body["inline"] = (
            {"path": path, "to": line} if line is not None
            else {"path": path, "from": a.old_line}
        )
    if a.reply_to:
        body["parent"] = {"id": a.reply_to}

    c = post(session, f"{base}/comments", json=body).json()
    print(f"✓ comment {c['id']} — {c['links']['html']['href']}")


# ── Entry point ───────────────────────────────────────────────────────────────

WRITE = {"comment", "approve", "request-changes", "unapprove"}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return

    if sys.argv[1] == "setup":
        cmd_setup()
        return

    maybe_self_update()

    target = sys.argv[1]
    action = sys.argv[2] if len(sys.argv) > 2 else "all"
    valid = {"info", "diff", "comments", "files", "activity", "all"} | WRITE
    if action not in valid:
        sys.exit(f"error: action must be one of {sorted(valid)}")

    workspace, repo, pr_id = parse_target(target)
    email, token = load_creds()

    session = requests.Session()
    session.auth = (email, token)
    session.headers["Accept"] = "application/json"

    base = f"{API}/repositories/{workspace}/{repo}/pullrequests/{pr_id}"

    if action in WRITE:
        if action == "comment":
            do_comment(session, base, sys.argv)
        elif action == "approve":
            post(session, f"{base}/approve"); print("✓ approved")
        elif action == "request-changes":
            post(session, f"{base}/request-changes"); print("✓ changes requested")
        elif action == "unapprove":
            session.delete(f"{base}/approve"); print("✓ approval removed")
        return

    pr = get(session, base).json()

    if action in ("info", "all"):
        fmt_info(pr)
    if action in ("files", "all"):
        fmt_files(session, base)
    if action in ("comments", "all"):
        fmt_comments(session, base)
    if action in ("activity", "all"):
        fmt_activity(session, base)
    if action in ("diff", "all"):
        fmt_diff(session, pr, numbered=bool({"-n", "--line-numbers"} & set(sys.argv[3:])))


if __name__ == "__main__":
    main()
